# AI-Talk 설정 예시. 이 파일을 .env로 복사한 뒤 값을 채웁니다. .env는 git에 올리지 않습니다.
# 앱은 OS 환경 변수보다 .env의 값을 먼저 씁니다.

# 처음에 쓸 AI: claude(집) | pgpt(회사 OA망) | mock(AI를 부르지 않고 화면만 확인)
# 실행한 뒤에는 설정 화면에서 바로 바꿀 수 있고, 마지막에 고른 것을 기억합니다.
AITALK_PROVIDER=mock

# --- Claude ---
ANTHROPIC_API_KEY=

# --- P-GPT (회사 OA망에서만 연결됩니다) ---
PGPT_API_KEY=
PGPT_EMPNO=
# 시스템 코드를 따로 받았을 때만 씁니다. 비워 두면 사번을 대신 씁니다.
# PGPT_SYSTEM_CODE=
# 주소가 기본값과 다를 때만 씁니다.
# PGPT_BASE_URL=http://pgpt.posco.com/s0la01-gpt/v1
# 웹 검색 도구 이름. 기본은 web_search이고, 안 되면 web_search_preview로 자동으로 바꿔 봅니다.
# PGPT_WEB_SEARCH_TOOL=web_search

# --- 같은 망의 다른 PC에서 접속 ---
# 기본으로 켜져 있습니다. 실행 창과 설정 화면에 접속 주소(http://이PC의IP:포트)가 나옵니다.
# 이 PC에서만 쓰려면 아래 줄의 주석을 풉니다.
# AITALK_HOST=127.0.0.1
# AITALK_PORT=8765
# 다른 PC에서 들어올 때 물을 접속 코드. 비워 두면 같은 망의 누구나 들어와 내 AI 키로 토론을 돌릴 수 있습니다.
# AITALK_ACCESS_CODE=

# --- 비용 표시 (선택) ---
# 화면의 비용은 원화로 보여 줍니다. 환율은 1달러 = 1,350원으로 고정되어 있습니다.
# 웹 검색 한 건의 요금(달러). Claude 공개 요금은 1,000건에 10달러입니다 (건당 약 14원).
# AITALK_SEARCH_USD=0.01
